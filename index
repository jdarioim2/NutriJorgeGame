<!DOCTYPE html>
<html lang="es">  
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>NutriJorge: Nutriendo a Pasaje - Proyecto Beca IA</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            box-sizing: border-box;
        }
        html, body {
            width: 100%;
            height: 100%;
            height: 100dvh;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at center, #0f172a 0%, #020617 100%);
            overflow: hidden;
            touch-action: none;
        }
        .font-display {
            font-family: 'Fredoka', sans-serif;
        }
        #game-canvas {
            display: block;
            width: 100%;
            height: 100%;
            cursor: crosshair;
            touch-action: none;
        }
        .btn-game {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 0 rgba(0, 0, 0, 0.28);
        }
        .btn-game:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 0 rgba(0, 0, 0, 0.32);
        }
        .btn-game:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 rgba(0, 0, 0, 0.25);
        }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }
        .animate-float {
            animation: floatSlow 2.8s ease-in-out infinite;
        }

        /* Mostrar controles táctiles en móviles, tablets y pantallas táctiles (incluso en horizontal) */
        #touch-controls {
            display: flex;
        }
        @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
            #touch-controls {
                display: none !important;
            }
        }

        /* Ajustes automáticos para celulares en modo horizontal (poca altura) */
        @media (max-height: 540px) {
            #hud-bar {
                padding-top: 0.25rem !important;
                padding-bottom: 0.25rem !important;
            }
            .hud-avatar-box {
                width: 2rem !important;
                height: 2rem !important;
            }
            .touch-pad-box {
                width: 6.8rem !important;
                height: 6.8rem !important;
                padding: 0.25rem !important;
            }
            #btn-touch-throw {
                width: 4.5rem !important;
                height: 4.5rem !important;
            }
            #btn-touch-dash {
                padding: 0.35rem 0.65rem !important;
                font-size: 0.65rem !important;
            }
            .modal-card {
                padding: 0.75rem 1rem !important;
            }
            .modal-avatar {
                width: 4.25rem !important;
                height: 4.25rem !important;
            }
        }
    </style>
</head>
<body class="w-full h-[100dvh] flex flex-col items-center justify-center p-0 sm:p-1.5 md:p-3">

    <!-- MAIN GAME SHELL -->
    <div id="game-shell" class="relative w-full h-full max-w-6xl lg:max-h-[860px] bg-sky-950 sm:rounded-3xl shadow-2xl border-0 sm:border-4 border-sky-400/40 flex flex-col overflow-hidden">

        <!-- TOP HUD BAR -->
        <header id="hud-bar" class="bg-gradient-to-r from-sky-700 via-blue-700 to-emerald-700 text-white px-2 sm:px-3 py-1.5 sm:py-2 flex flex-wrap items-center justify-between gap-1.5 sm:gap-2 z-20 border-b-2 sm:border-b-4 border-yellow-400 shadow-md shrink-0">
            <!-- Brand & Campaign Tag -->
            <div class="flex items-center gap-1.5 sm:gap-2">
                <div class="hud-avatar-box w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-amber-100 flex items-center justify-center shadow-inner border-2 border-yellow-400 overflow-hidden shrink-0">
                    <!-- Mini 3D Pixar-Style SVG Avatar of Ñaño Jorge (Lighter Skin & Natural Smile) -->
                    <svg viewBox="0 0 80 80" class="w-full h-full">
                        <defs>
                            <radialGradient id="hudSkin" cx="46%" cy="38%" r="58%">
                                <stop offset="0%" stop-color="#fff8f2"/>
                                <stop offset="65%" stop-color="#f8dcc6"/>
                                <stop offset="100%" stop-color="#e5b89b"/>
                            </radialGradient>
                            <linearGradient id="hudHair" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#4e3524"/>
                                <stop offset="55%" stop-color="#2b1b11"/>
                                <stop offset="100%" stop-color="#170e08"/>
                            </linearGradient>
                        </defs>
                        <circle cx="40" cy="40" r="38" fill="#fde68a"/>
                        <!-- White collared shirt -->
                        <path d="M14 78 C14 58 66 58 66 78 Z" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5"/>
                        <polygon points="28,58 40,68 33,73 22,63" fill="#e2e8f0"/>
                        <polygon points="52,58 40,68 47,73 58,63" fill="#e2e8f0"/>
                        <!-- Ears -->
                        <ellipse cx="17" cy="41" rx="5.5" ry="7.5" fill="#f5d3bd" stroke="#d59f7e" stroke-width="1"/>
                        <ellipse cx="63" cy="41" rx="5.5" ry="7.5" fill="#f5d3bd" stroke="#d59f7e" stroke-width="1"/>
                        <!-- Plump 3D Pixar-style Head -->
                        <path d="M20 34 C19 19 28 15 40 15 C52 15 61 19 60 34 C62 49 54 61 40 61 C26 61 18 49 20 34 Z" fill="url(#hudSkin)" stroke="#d59f7e" stroke-width="1.2"/>
                        <!-- Soft warm cheeks -->
                        <ellipse cx="26" cy="44" rx="5.5" ry="3.5" fill="#f4978e" opacity="0.22"/>
                        <ellipse cx="54" cy="44" rx="5.5" ry="3.5" fill="#f4978e" opacity="0.22"/>
                        <!-- Voluminous side-parted dark brown hair -->
                        <path d="M19 34 C17 20 23 10 39 9 C48 9 54 12 56 15 C61 16 63 24 61 34 C59 25 56 20 51 19 C43 21 29 20 23 24 C21 27 20 31 19 34 Z" fill="url(#hudHair)"/>
                        <!-- Thick expressive dark eyebrows -->
                        <path d="M24 28 Q31 24.5 37 27.5" stroke="#23150c" stroke-width="3.4" stroke-linecap="round" fill="none"/>
                        <path d="M43 27.5 Q49 24.5 56 28" stroke="#23150c" stroke-width="3.4" stroke-linecap="round" fill="none"/>
                        <!-- Big 3D Cartoon Eyes with Brown Irises & Catchlights -->
                        <ellipse cx="31.5" cy="35" rx="5.6" ry="6" fill="#ffffff" stroke="#6b442a" stroke-width="1"/>
                        <ellipse cx="48.5" cy="35" rx="5.6" ry="6" fill="#ffffff" stroke="#6b442a" stroke-width="1"/>
                        <circle cx="32" cy="35.2" r="3.7" fill="#4a2511"/>
                        <circle cx="48" cy="35.2" r="3.7" fill="#4a2511"/>
                        <circle cx="32" cy="35.2" r="1.9" fill="#140a04"/>
                        <circle cx="48" cy="35.2" r="1.9" fill="#140a04"/>
                        <circle cx="30.4" cy="33.5" r="1.4" fill="#ffffff"/>
                        <circle cx="46.4" cy="33.5" r="1.4" fill="#ffffff"/>
                        <!-- Cute Rounded 3D Nose -->
                        <ellipse cx="40" cy="41.5" rx="5.2" ry="4" fill="#f3c8ad" stroke="#cf926e" stroke-width="1"/>
                        <ellipse cx="39" cy="40.2" rx="2.2" ry="1.3" fill="#ffffff" opacity="0.65"/>
                        <!-- Natural, Warm, Friendly Smile -->
                        <path d="M28.5 46.5 Q26.5 48.5 28.5 50.5" stroke="#c88a68" stroke-width="1.1" stroke-linecap="round" fill="none"/>
                        <path d="M51.5 46.5 Q53.5 48.5 51.5 50.5" stroke="#c88a68" stroke-width="1.1" stroke-linecap="round" fill="none"/>
                        <path d="M30 47.5 Q40 52 50 47.5" stroke="#9e5435" stroke-width="2" stroke-linecap="round" fill="none"/>
                        <path d="M34 51.2 Q40 53.2 46 51.2" stroke="#d49572" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-1 sm:gap-1.5">
                        <h1 class="font-display text-sm sm:text-xl font-bold tracking-wide leading-none text-white drop-shadow">
                            NutriJorge
                        </h1>
                        <span class="hidden xs:inline-block sm:inline-block bg-yellow-400 text-blue-950 text-[9px] sm:text-[10px] font-extrabold px-1.5 sm:px-2 py-0.5 rounded-full uppercase tracking-wider shadow-sm">
                            Ñaño Jorge
                        </span>
                    </div>
                    <p class="text-[10px] sm:text-[11px] text-sky-100 hidden md:block leading-tight">
                        Parque Central de Pasaje • 3 Cerritos • Los Naranjos • Beca IA
                    </p>
                </div>
            </div>

            <!-- Live Metrics -->
            <div class="flex items-center gap-1 sm:gap-2.5 order-3 sm:order-2 w-full sm:w-auto justify-between sm:justify-center">
                <!-- Kids Fed Counter -->
                <div class="bg-blue-950/60 border border-sky-300/30 rounded-xl px-2 py-1 flex items-center gap-1.5 flex-1 sm:flex-initial justify-center">
                    <span class="text-sm sm:text-lg">👧👦</span>
                    <div>
                        <div class="text-[8px] sm:text-[9px] uppercase tracking-wider text-sky-200 font-bold leading-none">Niños</div>
                        <div id="hud-kids" class="font-display font-bold text-xs sm:text-base text-yellow-300 leading-tight">0</div>
                    </div>
                </div>

                <!-- Score & Combo -->
                <div class="bg-blue-950/60 border border-sky-300/30 rounded-xl px-2 py-1 flex items-center gap-1.5 flex-1 sm:flex-initial justify-center">
                    <span class="text-sm sm:text-lg">⭐</span>
                    <div>
                        <div class="text-[8px] sm:text-[9px] uppercase tracking-wider text-sky-200 font-bold leading-none">Puntos</div>
                        <div class="flex items-center gap-1">
                            <span id="hud-score" class="font-display font-bold text-xs sm:text-base text-white leading-tight">0</span>
                            <span id="hud-combo" class="hidden text-[9px] sm:text-[10px] font-extrabold bg-amber-400 text-slate-950 px-1 rounded-full">x2</span>
                        </div>
                    </div>
                </div>

                <!-- Milk Inventory -->
                <div class="bg-blue-950/60 border border-sky-300/30 rounded-xl px-2 py-1 flex items-center gap-1 flex-1 sm:flex-initial justify-center">
                    <div>
                        <div class="text-[8px] sm:text-[9px] uppercase tracking-wider text-sky-200 font-bold leading-none mb-0.5">Leche</div>
                        <div id="hud-milk-icons" class="flex items-center gap-0.5 text-xs sm:text-base leading-none"></div>
                    </div>
                </div>

                <!-- Countdown Timer -->
                <div class="bg-blue-950/60 border border-sky-300/30 rounded-xl px-2 py-1 flex items-center gap-1 flex-1 sm:flex-initial justify-center">
                    <span class="text-sm sm:text-lg">⏱️</span>
                    <div>
                        <div class="text-[8px] sm:text-[9px] uppercase tracking-wider text-sky-200 font-bold leading-none">Tiempo</div>
                        <div id="hud-timer" class="font-display font-bold text-xs sm:text-base text-emerald-300 leading-tight">30s</div>
                    </div>
                </div>
            </div>

            <!-- Action Controls -->
            <div class="flex items-center gap-1 sm:gap-1.5 order-2 sm:order-3">
                <button id="btn-cabezon" title="Cambiar tamaño de cabeza de Ñaño Jorge" class="btn-game bg-amber-400 hover:bg-amber-300 text-blue-950 px-2 sm:px-2.5 py-1 sm:py-1.5 rounded-xl text-[11px] sm:text-xs font-extrabold border border-yellow-200 flex items-center gap-1">
                    <span>😄</span>
                    <span id="lbl-cabezon" class="hidden lg:inline">Cabezón</span>
                </button>
                <button id="btn-fullscreen" title="Pantalla Completa" class="btn-game bg-indigo-600 hover:bg-indigo-500 text-white w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center border border-indigo-300/40">
                    <i id="icon-fullscreen" class="fas fa-expand text-xs sm:text-sm"></i>
                </button>
                <button id="btn-sound" title="Sonido" class="btn-game bg-sky-600 hover:bg-sky-500 text-white w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center border border-sky-300/40">
                    <i id="icon-sound" class="fas fa-volume-up text-xs sm:text-sm"></i>
                </button>
                <button id="btn-pause" title="Pausar Juego" class="btn-game bg-amber-500 hover:bg-amber-400 text-slate-950 w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center border border-yellow-200">
                    <i id="icon-pause" class="fas fa-pause text-xs sm:text-sm"></i>
                </button>
            </div>
        </header>

        <!-- CANVAS STAGE -->
        <div id="canvas-container" class="relative flex-1 w-full bg-amber-100 overflow-hidden">
            <canvas id="game-canvas"></canvas>

            <!-- Active Powerup Banner -->
            <div id="powerup-banner" class="hidden absolute top-2 sm:top-3 left-1/2 -translate-x-1/2 z-10 bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-400 text-blue-950 font-display font-bold text-[11px] sm:text-sm px-3 sm:px-4 py-1 sm:py-1.5 rounded-full shadow-lg border-2 border-white flex items-center gap-1.5 whitespace-nowrap">
                <span id="powerup-icon">⚡</span>
                <span id="powerup-text">¡Energía Activa!</span>
            </div>

            <!-- Low Milk Alert Banner -->
            <div id="low-milk-banner" class="hidden absolute bottom-28 sm:bottom-6 left-1/2 -translate-x-1/2 z-10 bg-red-600/95 text-white font-display font-bold text-[11px] sm:text-sm px-3.5 py-1.5 rounded-full shadow-lg border-2 border-yellow-300 animate-bounce flex items-center gap-1.5 pointer-events-none whitespace-nowrap">
                <span>🥛 ¡SIN LECHE! Ve al Camión NutriJorge</span>
            </div>

            <!-- MOBILE / TABLET TOUCH CONTROLS OVERLAY -->
            <div id="touch-controls" class="absolute inset-x-0 bottom-2 sm:bottom-3 px-3 sm:px-5 items-end justify-between pointer-events-none z-10">
                <!-- Virtual D-Pad / Touch Joystick Pad -->
                <div id="touch-pad" class="touch-pad-box pointer-events-auto bg-slate-900/60 backdrop-blur-md p-1.5 rounded-2xl border border-white/25 grid grid-cols-3 gap-1 w-32 h-32 sm:w-36 sm:h-36 shadow-xl touch-none">
                    <div></div>
                    <button data-dir="up" class="dpad-btn bg-sky-600/90 active:bg-yellow-400 active:text-slate-950 text-white rounded-xl flex items-center justify-center text-base sm:text-lg shadow">
                        <i class="fas fa-chevron-up"></i>
                    </button>
                    <div></div>
                    <button data-dir="left" class="dpad-btn bg-sky-600/90 active:bg-yellow-400 active:text-slate-950 text-white rounded-xl flex items-center justify-center text-base sm:text-lg shadow">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div class="bg-slate-800/80 rounded-xl flex items-center justify-center text-[9px] font-bold text-sky-200">
                        ÑAÑO
                    </div>
                    <button data-dir="right" class="dpad-btn bg-sky-600/90 active:bg-yellow-400 active:text-slate-950 text-white rounded-xl flex items-center justify-center text-base sm:text-lg shadow">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <div></div>
                    <button data-dir="down" class="dpad-btn bg-sky-600/90 active:bg-yellow-400 active:text-slate-950 text-white rounded-xl flex items-center justify-center text-base sm:text-lg shadow">
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div></div>
                </div>

                <!-- Throw Milk & Dash Buttons -->
                <div class="pointer-events-auto flex flex-col items-end gap-2">
                    <button id="btn-touch-dash" class="btn-game bg-amber-400 active:bg-amber-300 text-slate-950 font-display font-bold px-3.5 py-2 rounded-2xl border-2 border-white shadow-lg flex items-center gap-1.5 text-xs">
                        <i class="fas fa-bolt"></i>
                        <span>IMPULSO</span>
                    </button>
                    <button id="btn-touch-throw" class="btn-game bg-emerald-500 active:bg-emerald-400 text-white font-display font-bold w-20 h-20 sm:w-24 sm:h-24 rounded-full border-4 border-yellow-300 shadow-2xl flex flex-col items-center justify-center">
                        <span class="text-xl sm:text-2xl leading-none">🥛</span>
                        <span class="text-[10px] sm:text-[11px] tracking-tight mt-0.5">ENTREGAR</span>
                    </button>
                </div>
            </div>

            <!-- START / WELCOME MODAL -->
            <div id="start-modal" class="absolute inset-0 z-30 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4 overflow-y-auto">
                <div class="modal-card bg-gradient-to-b from-white to-sky-50 max-w-xl w-full max-h-full overflow-y-auto rounded-2xl sm:rounded-3xl p-4 sm:p-6 border-4 border-yellow-400 shadow-2xl text-center relative my-auto">
                    <!-- Top Scholarship Badge -->
                    <div class="inline-flex items-center gap-1.5 sm:gap-2 bg-gradient-to-r from-blue-600 to-emerald-600 text-white text-[10px] sm:text-xs font-bold px-3 py-1 rounded-full shadow mb-1.5 sm:mb-2">
                        <i class="fas fa-robot text-yellow-300"></i>
                        <span>Proyecto Beca de Inteligencia Artificial • Pasaje, El Oro</span>
                    </div>

                    <!-- Hero Avatar ("Ñaño Jorge" 3D Pixar Portrait - Lighter Skin & Natural Smile) -->
                    <div class="flex justify-center mb-1.5 sm:mb-2">
                        <div class="modal-avatar w-20 h-20 sm:w-28 sm:h-28 rounded-2xl sm:rounded-3xl bg-gradient-to-b from-amber-200 via-orange-100 to-sky-100 border-4 border-amber-400 shadow-xl flex items-center justify-center overflow-hidden animate-float">
                            <svg viewBox="0 0 140 140" class="w-full h-full">
                                <!-- Cute Rounded 3D Bulb Nose -->
                                <ellipse cx="70" cy="66" rx="10" ry="7.6" fill="#f3c8ad" stroke="#cf926e" stroke-width="1.4"/>
                                <ellipse cx="68" cy="63.8" rx="4.2" ry="2.4" fill="#ffffff" opacity="0.65"/>
                                <!-- Natural Warm Dimples -->
                                <path d="M47 74 Q44 77.5 47.5 81" stroke="#c98b69" stroke-width="1.7" stroke-linecap="round" fill="none"/>
                                <path d="M93 74 Q96 77.5 92.5 81" stroke="#c98b69" stroke-width="1.7" stroke-linecap="round" fill="none"/>
                                <!-- Natural, Warm, Friendly Smile (soft curved lips) -->
                                <path d="M50 76.5 Q70 84.5 90 76.5 Q70 80.5 50 76.5 Z" fill="#ffffff" stroke="#b06949" stroke-width="1.5" stroke-linejoin="round"/>
                                <path d="M49 76 Q70 82.5 91 76" stroke="#9e5435" stroke-width="2.4" stroke-linecap="round" fill="none"/>
                                <!-- Soft Lower Lip & Chin Highlight -->
                                <path d="M58 84 Q70 87.5 82 84" stroke="#d49572" stroke-width="1.6" stroke-linecap="round" fill="none"/>
                            </svg>
                        </div>
                    </div>

                    <h2 class="font-display font-bold text-2xl sm:text-4xl text-blue-950 tracking-tight">
                        NutriJorge: Ñaño Jorge Loayza
                    </h2>
                    <p class="text-[11px] sm:text-sm text-slate-600 mt-1 max-w-md mx-auto leading-relaxed">
                        ¡Juega con él <strong class="text-blue-700">"Ñaño Jorge" (Jorge Loayza)</strong> en el <strong class="text-emerald-700">Parque Central de Pasaje</strong>! Comienzas con <strong class="text-rose-600">30 segundos</strong>, a los <strong class="text-emerald-700">15 segundos</strong> sale el primer reloj y el camión se mueve rápido entre las esquinas y el centro.
                    </p>

                    <!-- Instructions Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 my-2.5 sm:my-3.5 text-left">
                        <div class="bg-sky-100/80 border border-sky-200 p-2 sm:p-2.5 rounded-2xl flex items-center gap-2">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-sky-600 text-white flex items-center justify-center shrink-0 font-bold text-sm sm:text-base">
                                🎮
                            </div>
                            <div class="text-[11px] sm:text-xs">
                                <div class="font-bold text-slate-800">Muévete Rápido</div>
                                <div class="text-slate-600">Usa <b>WASD / Flechas</b> o el mando táctil.</div>
                            </div>
                        </div>
                        <div class="bg-emerald-100/80 border border-emerald-200 p-2 sm:p-2.5 rounded-2xl flex items-center gap-2">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 font-bold text-sm sm:text-base">
                                🎯
                            </div>
                            <div class="text-[11px] sm:text-xs">
                                <div class="font-bold text-slate-800">Auto-Entrega</div>
                                <div class="text-slate-600"><b>Espacio / Clic</b> o acércate al niño para darle leche.</div>
                            </div>
                        </div>
                        <div class="bg-amber-100/80 border border-amber-200 p-2 sm:p-2.5 rounded-2xl flex items-center gap-2">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center shrink-0 font-bold text-sm sm:text-base">
                                ⏰
                            </div>
                            <div class="text-[11px] sm:text-xs">
                                <div class="font-bold text-slate-800">30s + Reloj a los 15s</div>
                                <div class="text-slate-600">El camión corre rápido y el primer <b>Reloj ⏰</b> sale a los 15s.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Difficulty / Speed Selector -->
                    <div class="mb-3 sm:mb-4">
                        <div class="flex items-center justify-between max-w-sm mx-auto mb-1.5 px-1">
                            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-slate-500">Dificultad de la Jornada</span>
                            <span class="text-[10px] sm:text-[11px] font-bold text-amber-600">🏆 Récord: <span id="menu-highscore">0</span> pts</span>
                        </div>
                        <div class="flex flex-wrap justify-center gap-1.5 sm:gap-2">
                            <button data-diff="easy" class="diff-btn px-3 py-1.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-700">
                                🌱 Fácil (30s)
                            </button>
                            <button data-diff="normal" class="diff-btn px-3 py-1.5 rounded-xl text-xs font-bold border-2 border-blue-600 bg-blue-600 text-white shadow">
                                ⭐ Normal (30s)
                            </button>
                            <button data-diff="fast" class="diff-btn px-3 py-1.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-700">
                                🔥 Rápido (30s)
                            </button>
