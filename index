                g.fillStyle = s % 2 === 0 ? '#9a3412' : '#78350f';
                g.strokeStyle = '#fcd34d';
                g.lineWidth = 1.5;
                g.beginPath();
                g.moveTo(cx, cy - s * 11 - 6);
                g.lineTo(cx + s * 18 + 10, cy);
                g.lineTo(cx, cy + s * 10 + 4);
                g.lineTo(cx - s * 18 - 10, cy);
                g.closePath();
                g.fill();
                g.stroke();
            }

            g.fillStyle = '#a8a29e';
            g.strokeStyle = '#57534e';
            roundRect(g, cx - 14, cy - 52, 28, 46, 3, true, true);

            g.fillStyle = '#713f12';
            g.beginPath();
            g.arc(cx, cy - 64, 7, 0, Math.PI * 2);
            g.fill();
            g.fillRect(cx - 6, cy - 57, 12, 14);
        }

        function drawRightWavyCanopyTo(g, cx, cy) {
            g.fillStyle = 'rgba(148, 163, 184, 0.55)';
            g.beginPath();
            g.ellipse(cx, cy + 25, 95, 42, -0.15, 0, Math.PI * 2);
            g.fill();

            g.fillStyle = '#78350f';
            g.fillRect(cx - 55, cy - 5, 10, 42);
            g.fillRect(cx - 5, cy - 12, 10, 42);
            g.fillRect(cx + 45, cy - 18, 10, 42);

            const roofGrad = g.createLinearGradient(cx - 80, cy - 55, cx + 80, cy);
            roofGrad.addColorStop(0, '#1d4ed8');
            roofGrad.addColorStop(0.5, '#3b82f6');
            roofGrad.addColorStop(1, '#1e40af');
            g.fillStyle = roofGrad;
            g.strokeStyle = '#ffffff';
            g.lineWidth = 3;

            g.beginPath();
            g.moveTo(cx - 82, cy - 28);
            g.bezierCurveTo(cx - 35, cy - 62, cx + 25, cy - 12, cx + 78, cy - 42);
            g.lineTo(cx + 92, cy - 12);
            g.bezierCurveTo(cx + 35, cy + 16, cx - 25, cy - 30, cx - 68, cy + 2);
            g.closePath();
            g.fill();
            g.stroke();
        }

        function drawPalmTreeTo(g, x, y, scale = 1) {
            g.save();
            g.translate(x, y);
            g.scale(scale, scale);

            g.fillStyle = 'rgba(0,0,0,0.16)';
            g.beginPath();
            g.ellipse(0, 16, 18, 7, 0, 0, Math.PI * 2);
            g.fill();

            g.strokeStyle = '#78350f';
            g.lineWidth = 6;
            g.beginPath();
            g.moveTo(0, 16);
            g.quadraticCurveTo(3, -5, 0, -24);
            g.stroke();

            g.strokeStyle = '#15803d';
            g.lineWidth = 4.5;
            g.lineCap = 'round';
            const angles = [-2.6, -2.0, -1.2, -0.5, 0.2, 0.9];
            for (const a of angles) {
                g.beginPath();
                g.moveTo(0, -24);
                g.quadraticCurveTo(Math.cos(a) * 14, -28 + Math.sin(a) * 10, Math.cos(a) * 24, -18 + Math.sin(a) * 14);
                g.stroke();
            }
            g.restore();
        }

        function drawDoubleLamppostTo(g, x, y) {
            g.save();
            g.translate(x, y);
            g.strokeStyle = '#0f172a';
            g.lineWidth = 3;
            g.beginPath();
            g.moveTo(0, 12);
            g.lineTo(0, -22);
            g.moveTo(-8, -18);
            g.quadraticCurveTo(0, -24, 8, -18);
            g.stroke();

            g.fillStyle = '#ffffff';
            g.strokeStyle = '#cbd5e1';
            g.lineWidth = 1;
            g.beginPath();
            g.arc(-8, -20, 4.2, 0, Math.PI * 2);
            g.arc(8, -20, 4.2, 0, Math.PI * 2);
            g.fill();
            g.stroke();
            g.restore();
        }

        function drawSectorPortalTo(g, sec) {
            g.save();
            g.translate(sec.x, sec.y);

            g.fillStyle = 'rgba(0,0,0,0.22)';
            roundRect(g, -58, -22, 116, 36, 10, true, false);

            g.fillStyle = '#ffffff';
            g.strokeStyle = sec.color;
            g.lineWidth = 3;
            roundRect(g, -56, -26, 112, 36, 10, true, true);

            g.fillStyle = sec.roof;
            roundRect(g, -54, -24, 108, 13, 6, true, false);

            g.fillStyle = '#fef08a';
            g.font = 'bold 7.5px "Inter", sans-serif';
            g.textAlign = 'center';
            g.fillText(sec.sub, 0, -15);

            g.fillStyle = '#0f172a';
            g.font = '900 11px "Fredoka", sans-serif';
            g.fillText(`${sec.icon} ${sec.name}`, 0, 2);

            g.restore();
        }

        function drawAutoAimReticle(kid) {
            ctx.save();
            ctx.translate(kid.x, kid.y);
            const pulse = 1 + Math.sin(gameState.worldTime * 10) * 0.08;
            ctx.strokeStyle = '#16a34a';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.arc(0, 2, 28 * pulse, 0, Math.PI * 2);
            ctx.stroke();

            ctx.fillStyle = '#16a34a';
            ctx.font = 'bold 9px "Inter", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('🎯 AUTO', 0, 38);
            ctx.restore();
        }

        function drawNutriTruck(x, y) {
            if (truckStation.isMoving) {
                ctx.save();
                ctx.strokeStyle = 'rgba(2, 132, 199, 0.55)';
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(x, y + 10);
                ctx.lineTo(truckStation.targetX, truckStation.targetY + 10);
                ctx.stroke();

                ctx.fillStyle = 'rgba(14, 165, 233, 0.25)';
                ctx.strokeStyle = '#0284c7';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                ctx.arc(truckStation.targetX, truckStation.targetY + 12, truckStation.refillRadius * 0.85, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();
                ctx.restore();
            }

            ctx.save();
            ctx.translate(x, y);

            const pulse = 1 + Math.sin(gameState.worldTime * 5) * 0.05;
            const isAboutToMove = !truckStation.isMoving && truckStation.moveTimer <= 2.5;
            ctx.strokeStyle = isAboutToMove
                ? 'rgba(245, 158, 11, 0.9)'
                : (player.milk <= 1 ? 'rgba(239, 68, 68, 0.85)' : 'rgba(14, 165, 233, 0.7)');
            ctx.fillStyle = isAboutToMove
                ? 'rgba(254, 243, 199, 0.35)'
                : (player.milk <= 1 ? 'rgba(254, 202, 202, 0.32)' : 'rgba(224, 242, 254, 0.38)');
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(0, 8, truckStation.refillRadius * pulse, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            if (truckBodySpriteCanvas) {
                ctx.drawImage(truckBodySpriteCanvas, -72, -46);
            }

            ctx.fillStyle = isAboutToMove ? '#dc2626' : '#15803d';
            ctx.font = 'bold 8.5px "Inter", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(
                truckStation.isMoving
                    ? '¡EN MOVIMIENTO!'
                    : (isAboutToMove ? `¡MUEVE EN ${Math.ceil(truckStation.moveTimer)}s!` : 'RECARGA AQUÍ'),
                -15,
                2
            );

            if (!truckStation.isMoving) {
                const moveRatio = Math.max(0, truckStation.moveTimer / truckStation.moveInterval);
                ctx.fillStyle = 'rgba(15, 23, 42, 0.75)';
                ctx.fillRect(-46, -42, 92, 6);
                ctx.fillStyle = isAboutToMove ? '#f59e0b' : '#38bdf8';
                ctx.fillRect(-44, -40.5, 88 * moveRatio, 3.5);
            }

            ctx.restore();
        }

        function drawPlayer() {
            ctx.save();
            ctx.translate(player.x, player.y);

            const bob = Math.sin(player.walkCycle) * 3.2;
            const headScale = CABEZON_SCALES[gameState.cabezonMode] || 1.82;

            if (player.speedBoostTimer > 0 || player.multiMilkTimer > 0) {
                ctx.strokeStyle = player.multiMilkTimer > 0 ? '#3b82f6' : '#facc15';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.arc(0, 0, player.radius + 9 + Math.sin(gameState.worldTime * 10) * 3, 0, Math.PI * 2);
                ctx.stroke();
            }

            ctx.fillStyle = 'rgba(0,0,0,0.24)';
            ctx.beginPath();
            ctx.ellipse(0, 26, 22, 8.5, 0, 0, Math.PI * 2);
            ctx.fill();

            const footOffset = Math.sin(player.walkCycle) * 6.5;
            ctx.fillStyle = '#1e3a8a';
            roundRect(ctx, -13, 10 + bob * 0.4, 11, 14 + footOffset * 0.4, 4, true, false);
            roundRect(ctx, 2, 10 + bob * 0.4, 11, 14 - footOffset * 0.4, 4, true, false);

            ctx.fillStyle = '#0f172a';
            ctx.beginPath();
            ctx.ellipse(-8, 23 + footOffset * 0.5, 6.5, 4, 0, 0, Math.PI * 2);
            ctx.ellipse(8, 23 - footOffset * 0.5, 6.5, 4, 0, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 2;
            roundRect(ctx, -19, -8 + bob, 38, 22, 11, true, true);

            ctx.fillStyle = '#271c15';
            ctx.fillRect(-18, 9 + bob, 36, 5);
            ctx.fillStyle = '#e2e8f0';
            ctx.strokeStyle = '#475569';
            ctx.lineWidth = 1;
            ctx.strokeRect(-4, 8.5 + bob, 8, 6);

            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(0, -3 + bob);
            ctx.lineTo(0, 9 + bob);
            ctx.stroke();
            ctx.strokeRect(4, -1 + bob, 7, 6);

            ctx.fillStyle = '#f8dcc6';
            ctx.beginPath();
            ctx.arc(-20, 2 + bob, 5.2, 0, Math.PI * 2);
            ctx.arc(20, 2 + bob, 5.2, 0, Math.PI * 2);
            ctx.fill();

            if (player.milk > 0 || player.multiMilkTimer > 0) {
                const handX = player.facingX * 15 + 14;
                const handY = player.facingY * 7 + 2 + bob;
                if (milkSpriteCanvas) {
                    ctx.drawImage(milkSpriteCanvas, handX - 11, handY - 13, 22, 25);
                }
            }

            // BIG BOBBLEHEAD ("ÑAÑO JORGE" 3D PIXAR-STYLE PORTRAIT)
            ctx.save();
            ctx.translate(player.headOffsetX, -22 + bob * 1.15);
            ctx.rotate(player.headTilt);

            const drawSize = 56 * headScale;
            const headSprite = player.smileBoostTimer > 0 ? jorgeHeadHappyCanvas : jorgeHeadNormalCanvas;
            if (headSprite) {
                ctx.drawImage(headSprite, -drawSize / 2, -drawSize / 2 - 4, drawSize, drawSize);
            }
            ctx.restore();

            const badgeY = -26 - 24 * headScale + bob;
            ctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
            roundRect(ctx, -38, badgeY - 12, 76, 15, 6, true, false);
            ctx.fillStyle = '#facc15';
            ctx.font = 'bold 9.5px "Fredoka", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('ÑAÑO JORGE', 0, badgeY - 1.5);

            ctx.restore();
        }

        function drawKid(k) {
            ctx.save();
            ctx.translate(k.x, k.y);
            const jump = k.state === 'happy'
                ? Math.abs(Math.sin(k.bouncePhase * 3)) * -10
                : Math.sin(k.bouncePhase) * 2;

            ctx.fillStyle = 'rgba(0,0,0,0.18)';
            ctx.beginPath();
            ctx.ellipse(0, 20, 14, 6, 0, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = k.shirtColor;
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1.8;
            roundRect(ctx, -12, -2 + jump, 24, 20, 7, true, true);

            if (k.state === 'happy' || k.patience < k.maxPatience * 0.45) {
                ctx.strokeStyle = k.skinColor;
                ctx.lineWidth = 4;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(-11, 2 + jump);
                ctx.lineTo(-19, -8 + jump);
                ctx.moveTo(11, 2 + jump);
                ctx.lineTo(19, -8 + jump);
                ctx.stroke();
            }

            ctx.fillStyle = k.skinColor;
            ctx.strokeStyle = '#7c2d12';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(0, -12 + jump, 12, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = k.hairColor;
            ctx.beginPath();
            ctx.arc(0, -14 + jump, 12.2, Math.PI, 0);
            ctx.fill();
            if (k.isGirl) {
                ctx.beginPath();
                ctx.arc(-12, -13 + jump, 4.5, 0, Math.PI * 2);
                ctx.arc(12, -13 + jump, 4.5, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.fillStyle = '#0f172a';
            ctx.beginPath();
            ctx.arc(-4, -12 + jump, 1.8, 0, Math.PI * 2);
            ctx.arc(4, -12 + jump, 1.8, 0, Math.PI * 2);
            ctx.fill();

            ctx.strokeStyle = '#7c2d12';
            ctx.lineWidth = 1.6;
            ctx.beginPath();
            if (k.state === 'happy') {
                ctx.arc(0, -8.5 + jump, 4.5, 0, Math.PI);
            } else {
                ctx.arc(0, -8 + jump, 3, 0.15 * Math.PI, 0.85 * Math.PI);
            }
            ctx.stroke();

            if (k.state === 'waiting') {
                const ratio = Math.max(0, k.patience / k.maxPatience);
                ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
                roundRect(ctx, -28, 22, 56, 12, 5, true, false);
                ctx.fillStyle = '#fde047';
                ctx.font = 'bold 7.5px "Inter", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(k.barrio, 0, 30.5);

                ctx.fillStyle = 'rgba(255,255,255,0.92)';
                ctx.strokeStyle = '#0284c7';
                ctx.lineWidth = 1.5;
                roundRect(ctx, -18, -42 + jump, 36, 14, 6, true, true);

                ctx.fillStyle = '#e2e8f0';
                ctx.fillRect(-14, -33 + jump, 28, 3.5);
                ctx.fillStyle = ratio > 0.5 ? '#22c55e' : (ratio > 0.25 ? '#f59e0b' : '#ef4444');
                ctx.fillRect(-14, -33 + jump, 28 * ratio, 3.5);

                ctx.fillStyle = '#0f172a';
                ctx.font = 'bold 7.5px "Inter", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('¡LECHE!', 0, -34.5 + jump);
            } else if (heartSpriteCanvas) {
                ctx.drawImage(heartSpriteCanvas, -12, -52 + jump, 24, 24);
            }

            ctx.restore();
        }

        function drawMilkCarton(proj) {
            ctx.save();
            ctx.translate(proj.x, proj.y);
            ctx.rotate(proj.rotation);
            if (milkSpriteCanvas) {
                ctx.drawImage(milkSpriteCanvas, -14, -16, 28, 32);
            }
            ctx.restore();
        }

        function drawParticle(pt) {
            const alpha = Math.max(0, pt.life / pt.maxLife);
            const sprite = pt.spriteType === 0 ? heartSpriteCanvas : starSpriteCanvas;
            if (!sprite) return;
            const size = 24 * pt.scale;
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.drawImage(sprite, pt.x - size / 2, pt.y - size / 2, size, size);
            ctx.restore();
        }

        function drawPowerup(p) {
            ctx.save();
            ctx.translate(p.x, p.y);
            const bounce = Math.sin(gameState.worldTime * 6) * 4;

            if (p.type === 'time') {
                const ringPulse = 1 + Math.sin(gameState.worldTime * 10) * 0.14;
                ctx.strokeStyle = '#10b981';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                ctx.arc(0, bounce, (p.radius + 9) * ringPulse, 0, Math.PI * 2);
                ctx.stroke();
            }

            const sprite = powerupSprites[p.type];
            if (sprite) {
                ctx.drawImage(sprite, -32, bounce - 32);
            }

            if (p.type === 'time') {
                ctx.font = 'bold 10px "Fredoka", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillStyle = '#065f46';
                ctx.fillText('+TIEMPO', 0, bounce + p.radius + 11);
            }
            ctx.restore();
        }

        function roundRect(ctx, x, y, w, h, r, fill, stroke) {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.arcTo(x + w, y, x + w, y + h, r);
            ctx.arcTo(x + w, y + h, x, y + h, r);
            ctx.arcTo(x, y + h, x, y, r);
            ctx.arcTo(x, y, x + w, y, r);
            ctx.closePath();
            if (fill) ctx.fill();
            if (stroke) ctx.stroke();
        }

        /********************************************************************
         * 7. HUD, UI CONTROLS & MAIN ANIMATION LOOP
         ********************************************************************/
        function updateHUD() {
            document.getElementById('hud-kids').textContent = gameState.kidsFed;
            document.getElementById('hud-score').textContent = gameState.score;

            const comboEl = document.getElementById('hud-combo');
            if (gameState.combo >= 2) {
                comboEl.classList.remove('hidden');
                comboEl.textContent = `x${Math.min(gameState.combo, 5)}`;
            } else {
                comboEl.classList.add('hidden');
            }

            const isMulti = player.multiMilkTimer > 0;
            if (player.milk !== lastDisplayedMilk || isMulti !== lastDisplayedMulti) {
                lastDisplayedMilk = player.milk;
                lastDisplayedMulti = isMulti;
                const milkContainer = document.getElementById('hud-milk-icons');
                if (isMulti) {
                    milkContainer.innerHTML = '<span class="text-amber-300 font-bold text-xs">🌟 ILIMITADA</span>';
                } else {
                    milkContainer.innerHTML = '';
                    for (let i = 0; i < player.maxMilk; i++) {
                        const span = document.createElement('span');
                        span.textContent = '🥛';
                        span.className = i < player.milk ? 'opacity-100 scale-100' : 'opacity-25 grayscale scale-90';
                        milkContainer.appendChild(span);
                    }
                }
            }

            const lowBanner = document.getElementById('low-milk-banner');
            if (player.milk === 0 && player.multiMilkTimer <= 0 && gameState.status === 'playing') {
                lowBanner.classList.remove('hidden');
            } else {
                lowBanner.classList.add('hidden');
            }
        }

        function togglePause() {
            if (gameState.status === 'playing') {
                gameState.status = 'paused';
                document.getElementById('pause-modal').classList.remove('hidden');
                document.getElementById('icon-pause').className = 'fas fa-play text-sm';
            } else if (gameState.status === 'paused') {
                gameState.status = 'playing';
                document.getElementById('pause-modal').classList.add('hidden');
                document.getElementById('icon-pause').className = 'fas fa-pause text-sm';
            }
        }

        document.getElementById('btn-cabezon').addEventListener('click', () => {
            gameState.cabezonMode = (gameState.cabezonMode + 1) % CABEZON_SCALES.length;
            document.getElementById('lbl-cabezon').textContent = CABEZON_LABELS[gameState.cabezonMode];
            player.headTiltVel += 9;
            player.smileBoostTimer = 0.85;
            sfx.playRefill();
        });

        document.querySelectorAll('.diff-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                currentDifficulty = btn.dataset.diff;
                document.querySelectorAll('.diff-btn').forEach(b => {
                    b.className = 'diff-btn px-3.5 py-1.5 rounded-xl text-xs font-bold border-2 border-slate-300 bg-white text-slate-700';
                });
                btn.className = 'diff-btn px-3.5 py-1.5 rounded-xl text-xs font-bold border-2 border-blue-600 bg-blue-600 text-white shadow';
            });
        });

        document.getElementById('btn-start-game').addEventListener('click', startGame);
        document.getElementById('btn-resume-game').addEventListener('click', togglePause);
        document.getElementById('btn-restart-pause').addEventListener('click', startGame);
        document.getElementById('btn-play-again').addEventListener('click', startGame);
        document.getElementById('btn-pause').addEventListener('click', () => {
            if (gameState.status === 'playing' || gameState.status === 'paused') togglePause();
        });

        document.getElementById('btn-sound').addEventListener('click', () => {
            const muted = sfx.toggleMute();
            document.getElementById('icon-sound').className = muted ? 'fas fa-volume-mute text-xs sm:text-sm' : 'fas fa-volume-up text-xs sm:text-sm';
        });

        // Fullscreen Button for immersive mobile & desktop play
        document.getElementById('btn-fullscreen').addEventListener('click', () => {
            const shell = document.getElementById('game-shell');
            if (!document.fullscreenElement) {
                if (shell.requestFullscreen) shell.requestFullscreen().catch(() => {});
            } else {
                if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
            }
        });

        document.addEventListener('fullscreenchange', () => {
            const icon = document.getElementById('icon-fullscreen');
            icon.className = document.fullscreenElement ? 'fas fa-compress text-xs sm:text-sm' : 'fas fa-expand text-xs sm:text-sm';
            setTimeout(resizeCanvas, 60);
        });

        function resizeCanvas() {
            const container = document.getElementById('canvas-container');
            const rect = container.getBoundingClientRect();
            const aspect = Math.max(0.45, rect.width / Math.max(1, rect.height));

            // Keep crisp 650px vertical world height, and adapt horizontal viewport on portrait screens so nothing stretches
            camera.viewH = WORLD_H;
            camera.viewW = Math.min(WORLD_W, Math.max(540, Math.round(WORLD_H * aspect)));

            if (canvas.width !== camera.viewW || canvas.height !== camera.viewH) {
                canvas.width = camera.viewW;
                canvas.height = camera.viewH;
            }

            if (camera.viewW < WORLD_W) {
                camera.x = Math.max(0, Math.min(WORLD_W - camera.viewW, player.x - camera.viewW / 2));
            } else {
                camera.x = 0;
            }
            draw();
        }

        window.addEventListener('resize', resizeCanvas);
        window.addEventListener('orientationchange', () => setTimeout(resizeCanvas, 120));

        let lastFrameTime = performance.now();
        function gameLoop(now) {
            const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
            lastFrameTime = now;
            update(dt);
            draw();
            requestAnimationFrame(gameLoop);
        }

        window.onload = function () {
            initOffscreenCaches();
            resizeCanvas();
            updateHUD();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
