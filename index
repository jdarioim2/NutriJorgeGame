        function relocateTruckStation() {
            let nextIdx = 0;
            if (truckStation.waypointIndex === 0) {
                nextIdx = 1 + Math.floor(Math.random() * (TRUCK_WAYPOINTS.length - 1));
            } else {
                if (Math.random() < 0.45) {
                    nextIdx = 0;
                } else {
                    const corners = [1, 2, 3, 4].filter(idx => idx !== truckStation.waypointIndex);
                    nextIdx = corners[Math.floor(Math.random() * corners.length)];
                }
            }

            const wp = TRUCK_WAYPOINTS[nextIdx];
            truckStation.waypointIndex = nextIdx;
            truckStation.targetX = wp.x;
            truckStation.targetY = wp.y;
            truckStation.locationName = wp.label;
            truckStation.isMoving = true;

            sfx.playDash();
            addFloatingText(truckStation.x, truckStation.y - 45, `🚚 ¡Camión va a ${wp.label}!`, '#0284c7');
        }

        function spawnClockPowerup() {
            const activeClocks = powerups.filter(p => p.type === 'time').length;
            if (activeClocks >= 2) return;

            const cfg = DIFFICULTY_SETTINGS[currentDifficulty];
            let px = 155 + Math.random() * (WORLD_W - 310);
            let py = 230 + Math.random() * (WORLD_H - 300);

            for (let attempt = 0; attempt < 6; attempt++) {
                if (Math.hypot(px - player.x, py - player.y) > 140) break;
                px = 155 + Math.random() * (WORLD_W - 310);
                py = 230 + Math.random() * (WORLD_H - 300);
            }

            powerups.push({
                x: px,
                y: py,
                radius: 23,
                type: 'time',
                label: `+${cfg.clockBonus}s Tiempo Extra`,
                color: '#10b981',
                life: 9.5
            });

            sfx.playRefill();
            addFloatingText(px, py - 28, `⏰ ¡Reloj +${cfg.clockBonus}s!`, '#059669');
        }

        function spawnKid() {
            const cfg = DIFFICULTY_SETTINGS[currentDifficulty];
            const waitingKids = kids.filter(k => k.state === 'waiting');
            if (waitingKids.length >= cfg.maxKids) return;

            const availableSpots = kidSpawnSpots.filter(spot => {
                return !kids.some(k => Math.hypot(k.x - spot.x, k.y - spot.y) < 65);
            });
            if (availableSpots.length === 0) return;

            const spot = availableSpots[Math.floor(Math.random() * availableSpots.length)];
            const shirtColors = ['#ec4899', '#3b82f6', '#f59e0b', '#8b5cf6', '#10b981', '#ef4444'];
            const hairColors = ['#1e293b', '#451a03', '#78350f', '#0f172a'];
            const skinTones = ['#fed7aa', '#fdba74', '#f5d0a9', '#eab676'];

            kids.push({
                x: spot.x + (Math.random() * 14 - 7),
                y: spot.y + (Math.random() * 14 - 7),
                barrio: spot.barrio,
                radius: 22,
                shirtColor: shirtColors[Math.floor(Math.random() * shirtColors.length)],
                hairColor: hairColors[Math.floor(Math.random() * hairColors.length)],
                skinColor: skinTones[Math.floor(Math.random() * skinTones.length)],
                isGirl: Math.random() > 0.48,
                patience: cfg.kidPatience,
                maxPatience: cfg.kidPatience,
                state: 'waiting',
                happyTimer: 0,
                bouncePhase: Math.random() * Math.PI * 2
            });
        }

        function spawnPowerup() {
            const nonTimePowerups = powerups.filter(p => p.type !== 'time');
            if (nonTimePowerups.length >= 2) return;
            const types = [
                { type: 'speed', label: '¡Energía de Cacao!', color: '#f59e0b' },
                { type: 'multi', label: '¡Súper Entrega Múltiple!', color: '#3b82f6' }
            ];
            const chosen = types[Math.floor(Math.random() * types.length)];
            const px = 160 + Math.random() * (WORLD_W - 320);
            const py = 230 + Math.random() * (WORLD_H - 300);

            powerups.push({
                x: px,
                y: py,
                radius: 22,
                ...chosen,
                life: 11
            });
        }

        function findNearestWaitingKid(fromX, fromY, maxRange = 460) {
            let bestKid = null;
            let bestDist = maxRange;
            for (const k of kids) {
                if (k.state !== 'waiting') continue;
                const d = Math.hypot(k.x - fromX, k.y - fromY);
                if (d < bestDist) {
                    bestDist = d;
                    bestKid = k;
                }
            }
            return bestKid;
        }

        function triggerDash() {
            if (player.dashCooldown > 0) return;
            player.dashTimer = 0.24;
            player.dashCooldown = 0.85;
            player.headTiltVel += (player.facingX >= 0 ? -1 : 1) * 9;
            sfx.playDash();
            spawnParticleBurst(player.x, player.y + 10, 1, 5);
        }

        function throwMilk(targetX = null, targetY = null) {
            if (player.milk <= 0 && player.multiMilkTimer <= 0) {
                sfx.playEmpty();
                addFloatingText(player.x, player.y - 38, '¡Sin leche! Ve al Camión 🚚', '#ef4444');
                return;
            }

            let targetKid = null;
            let dirX = player.facingX;
            let dirY = player.facingY;

            if (targetX !== null && targetY !== null) {
                targetKid = findNearestWaitingKid(targetX, targetY, 150);
                const aimX = targetKid ? targetKid.x : targetX;
                const aimY = targetKid ? targetKid.y : targetY;
                const dx = aimX - player.x;
                const dy = aimY - player.y;
                const len = Math.hypot(dx, dy) || 1;
                dirX = dx / len;
                dirY = dy / len;
            } else {
                targetKid = findNearestWaitingKid(player.x, player.y, 480);
                if (targetKid) {
                    const dx = targetKid.x - player.x;
                    const dy = targetKid.y - player.y;
                    const len = Math.hypot(dx, dy) || 1;
                    dirX = dx / len;
                    dirY = dy / len;
                }
            }

            player.facingX = dirX;
            player.facingY = dirY;

            if (player.multiMilkTimer <= 0) {
                player.milk = Math.max(0, player.milk - 1);
            }

            player.headTiltVel += (dirX >= 0 ? 1 : -1) * 7.5;
            player.headVelX += dirX * 95;
            player.smileBoostTimer = 0.65;

            sfx.playThrow();

            const baseAngle = Math.atan2(dirY, dirX);
            const angles = player.multiMilkTimer > 0
                ? [baseAngle - 0.22, baseAngle, baseAngle + 0.22]
                : [baseAngle];

            angles.forEach((ang, idx) => {
                projectiles.push({
                    x: player.x + Math.cos(ang) * 24,
                    y: player.y + Math.sin(ang) * 24,
                    vx: Math.cos(ang) * 900,
                    vy: Math.sin(ang) * 900,
                    radius: 18,
                    rotation: 0,
                    life: 1.0,
                    homingTarget: idx === 0 || angles.length === 1 ? targetKid : null
                });
            });

            updateHUD();
        }

        function feedKid(kid) {
            if (kid.state !== 'waiting') return;
            kid.state = 'happy';
            kid.happyTimer = 0.85;
            player.smileBoostTimer = 1.1;

            gameState.kidsFed++;
            gameState.combo++;
            if (gameState.combo > gameState.maxCombo) {
                gameState.maxCombo = gameState.combo;
            }

            const comboMult = Math.min(gameState.combo, 5);
            const pts = 100 * comboMult;
            gameState.score += pts;

            sfx.playDeliver(gameState.combo);
            spawnParticleBurst(kid.x, kid.y - 14, 0, 5);

            const phrases = [
                '¡Gracias Ñaño Jorge!',
                '¡Qué rica leche, ñaño!',
                '¡NutriJorge!',
                '¡Arriba 3 Cerritos!',
                '¡Viva Pasaje!'
            ];
            const msg = phrases[Math.floor(Math.random() * phrases.length)];
            addFloatingText(kid.x, kid.y - 32, `${msg} +${pts}`, '#15803d');
            updateHUD();
        }

        function spawnParticleBurst(x, y, spriteType = 0, count = 5) {
            let spawned = 0;
            for (let i = 0; i < MAX_PARTICLES && spawned < count; i++) {
                const pt = particlePool[i];
                if (!pt.active) {
                    const angle = (Math.PI * 2 * spawned) / count + (Math.random() * 0.35 - 0.17);
                    const speed = 55 + Math.random() * 65;
                    pt.active = true;
                    pt.x = x;
                    pt.y = y;
                    pt.vx = Math.cos(angle) * speed;
                    pt.vy = Math.sin(angle) * speed - 38;
                    pt.spriteType = spriteType;
                    pt.life = 0.52;
                    pt.maxLife = 0.52;
                    pt.scale = 0.78 + Math.random() * 0.32;
                    spawned++;
                }
            }
        }

        function addFloatingText(x, y, text, color = '#15803d') {
            const safeX = Math.max(105, Math.min(WORLD_W - 105, x));
            const safeY = Math.max(55, Math.min(WORLD_H - 35, y));
            for (let i = 0; i < MAX_FLOATING_TEXTS; i++) {
                const ft = floatingTextPool[i];
                if (!ft.active) {
                    ft.active = true;
                    ft.x = safeX;
                    ft.y = safeY;
                    ft.text = text;
                    ft.color = color;
                    ft.life = 0.95;
                    ft.maxLife = 0.95;
                    return;
                }
            }
            const ft = floatingTextPool[0];
            ft.x = safeX;
            ft.y = safeY;
            ft.text = text;
            ft.color = color;
            ft.life = 0.95;
            ft.maxLife = 0.95;
        }

        function endGame() {
            gameState.status = 'gameover';
            sfx.playVictory();

            if (gameState.score > highScore) {
                highScore = gameState.score;
                localStorage.setItem('nutrijorge_highscore', highScore);
                document.getElementById('menu-highscore').textContent = highScore;
            }

            document.getElementById('end-kids').textContent = gameState.kidsFed;
            document.getElementById('end-score').textContent = gameState.score;
            document.getElementById('end-combo').textContent = `x${gameState.maxCombo}`;

            const medalEl = document.getElementById('end-medal');
            const titleEl = document.getElementById('end-title');
            if (gameState.kidsFed >= 20) {
                medalEl.textContent = '⭐⭐⭐';
                titleEl.textContent = '¡Héroe de la Nutrición en Pasaje!';
            } else if (gameState.kidsFed >= 10) {
                medalEl.textContent = '⭐⭐';
                titleEl.textContent = '¡Excelente Jornada con el Ñaño Jorge!';
            } else {
                medalEl.textContent = '⭐';
                titleEl.textContent = '¡Buen Comienzo en Pasaje!';
            }

            document.getElementById('gameover-modal').classList.remove('hidden');
        }

        /********************************************************************
         * 5. UPDATE LOOP (PHYSICS, BOBBLEHEAD & AI)
         ********************************************************************/
        function update(dt) {
            gameState.worldTime += dt;

            for (const c of clouds) {
                c.x += c.speed * dt;
                if (c.x > WORLD_W + 120) c.x = -120;
            }

            if (gameState.status !== 'playing') return;

            const cfg = DIFFICULTY_SETTINGS[currentDifficulty];

            gameState.timeLeft -= dt;
            if (gameState.timeLeft <= 0) {
                gameState.timeLeft = 0;
                updateHUD();
                endGame();
                return;
            }

            if (player.dashTimer > 0) player.dashTimer -= dt;
            if (player.dashCooldown > 0) player.dashCooldown -= dt;
            if (player.smileBoostTimer > 0) player.smileBoostTimer -= dt;
            if (player.speedBoostTimer > 0) player.speedBoostTimer -= dt;
            if (player.multiMilkTimer > 0) {
                player.multiMilkTimer -= dt;
                if (player.multiMilkTimer <= 0) updateHUD();
            }

            const banner = document.getElementById('powerup-banner');
            if (player.speedBoostTimer > 0 || player.multiMilkTimer > 0) {
                banner.classList.remove('hidden');
                if (player.multiMilkTimer > 0) {
                    document.getElementById('powerup-icon').textContent = '🌟';
                    document.getElementById('powerup-text').textContent = `¡Súper Entrega Múltiple (${Math.ceil(player.multiMilkTimer)}s)!`;
                } else {
                    document.getElementById('powerup-icon').textContent = '⚡';
                    document.getElementById('powerup-text').textContent = `¡Energía de Cacao (${Math.ceil(player.speedBoostTimer)}s)!`;
                }
            } else {
                banner.classList.add('hidden');
            }

            let moveX = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
            let moveY = (keys.down ? 1 : 0) - (keys.up ? 1 : 0);

            if (moveX !== 0 || moveY !== 0) {
                const len = Math.hypot(moveX, moveY);
                moveX /= len;
                moveY /= len;
                player.facingX = moveX;
                player.facingY = moveY;
                player.walkCycle += dt * 13;
                player.headVelX += -moveX * 42 * dt * 10;
            } else {
                player.walkCycle = 0;
            }

            let speed = cfg.playerSpeed;
            if (player.speedBoostTimer > 0) speed *= 1.42;
            if (player.dashTimer > 0) speed *= 2.15;

            player.x += moveX * speed * dt;
            player.y += moveY * speed * dt;

            const springForceX = -player.headOffsetX * 45 - player.headVelX * 7.5;
            player.headVelX += springForceX * dt;
            player.headOffsetX += player.headVelX * dt;
            player.headOffsetX = Math.max(-10, Math.min(10, player.headOffsetX));

            const tiltSpring = -player.headTilt * 38 - player.headTiltVel * 6.5;
            player.headTiltVel += tiltSpring * dt;
            player.headTilt += player.headTiltVel * dt;
            player.headTilt = Math.max(-0.28, Math.min(0.28, player.headTilt));

            player.x = Math.max(52, Math.min(WORLD_W - 52, player.x));
            player.y = Math.max(198, Math.min(WORLD_H - 38, player.y));

            // Smoothly follow Ñaño Jorge when viewport is narrower than WORLD_W (e.g., mobile portrait)
            if (camera.viewW < WORLD_W) {
                const targetCamX = Math.max(0, Math.min(WORLD_W - camera.viewW, player.x - camera.viewW / 2));
                camera.x += (targetCamX - camera.x) * Math.min(1, dt * 10);
            } else {
                camera.x = 0;
            }
            camera.y = 0;

            player.lockedKid = findNearestWaitingKid(player.x, player.y, 480);

            if (truckStation.isMoving) {
                const dx = truckStation.targetX - truckStation.x;
                const dy = truckStation.targetY - truckStation.y;
                const dist = Math.hypot(dx, dy);
                const step = truckStation.speed * dt;
                if (dist <= step) {
                    truckStation.x = truckStation.targetX;
                    truckStation.y = truckStation.targetY;
                    truckStation.isMoving = false;
                    truckStation.moveTimer = cfg.truckMoveInterval;
                } else {
                    truckStation.x += (dx / dist) * step;
                    truckStation.y += (dy / dist) * step;
                }
            } else {
                truckStation.moveTimer -= dt;
                if (truckStation.moveTimer <= 0) {
                    relocateTruckStation();
                }
            }

            const distToTruck = Math.hypot(player.x - truckStation.x, player.y - (truckStation.y + 8));
            if (distToTruck < truckStation.refillRadius && player.milk < player.maxMilk) {
                gameState.refillTickTimer += dt;
                if (gameState.refillTickTimer >= 0.08) {
                    gameState.refillTickTimer = 0;
                    player.milk = Math.min(player.maxMilk, player.milk + 2);
                    sfx.playRefill();
                    if (player.milk === player.maxMilk) {
                        addFloatingText(player.x, player.y - 40, '¡Leche Recargada! 🥛', '#0284c7');
                    }
                    updateHUD();
                }
            }

            gameState.spawnTimer -= dt;
            if (gameState.spawnTimer <= 0) {
                spawnKid();
                gameState.spawnTimer = cfg.spawnInterval;
            }

            gameState.powerupSpawnTimer -= dt;
            if (gameState.powerupSpawnTimer <= 0) {
                spawnPowerup();
                gameState.powerupSpawnTimer = 11 + Math.random() * 5;
            }

            gameState.clockSpawnTimer -= dt;
            if (gameState.clockSpawnTimer <= 0) {
                spawnClockPowerup();
                gameState.clockSpawnTimer = cfg.clockSpawnInterval;
            }

            for (let i = powerups.length - 1; i >= 0; i--) {
                const p = powerups[i];
                p.life -= dt;
                if (p.life <= 0) {
                    powerups.splice(i, 1);
                    continue;
                }
                if (Math.hypot(player.x - p.x, player.y - p.y) < player.radius + p.radius + 8) {
                    sfx.playPowerup();
                    addFloatingText(p.x, p.y - 25, p.label, p.color);
                    spawnParticleBurst(p.x, p.y, 1, 6);

                    if (p.type === 'speed') {
                        player.speedBoostTimer = 7.5;
                    } else if (p.type === 'multi') {
                        player.multiMilkTimer = 6.5;
                        player.milk = player.maxMilk;
                    } else if (p.type === 'time') {
                        gameState.timeLeft = Math.min(90, gameState.timeLeft + cfg.clockBonus);
                    }
                    powerups.splice(i, 1);
                    updateHUD();
                }
            }

            for (let i = kids.length - 1; i >= 0; i--) {
                const k = kids[i];
                k.bouncePhase += dt * 5;

                if (k.state === 'waiting') {
                    k.patience -= dt;

                    const distToPlayer = Math.hypot(player.x - k.x, player.y - k.y);
                    if (distToPlayer < player.radius + k.radius + 30 && (player.milk > 0 || player.multiMilkTimer > 0)) {
                        if (player.multiMilkTimer <= 0) player.milk--;
                        feedKid(k);
                        continue;
                    }

                    if (k.patience <= 0) {
                        gameState.combo = 0;
                        gameState.timeLeft = Math.max(1, gameState.timeLeft - 1.5);
                        addFloatingText(k.x, k.y - 25, '¡Se fue sin leche! -1.5s 😢', '#dc2626');
                        kids.splice(i, 1);
                        updateHUD();
                    }
                } else if (k.state === 'happy') {
                    k.happyTimer -= dt;
                    if (k.happyTimer <= 0) {
                        kids.splice(i, 1);
                    }
                }
            }

            for (let i = projectiles.length - 1; i >= 0; i--) {
                const proj = projectiles[i];

                if (proj.homingTarget && proj.homingTarget.state === 'waiting') {
                    const dx = proj.homingTarget.x - proj.x;
                    const dy = proj.homingTarget.y - proj.y;
                    const dist = Math.hypot(dx, dy) || 1;
                    const desiredVx = (dx / dist) * 920;
                    const desiredVy = (dy / dist) * 920;
                    proj.vx += (desiredVx - proj.vx) * Math.min(1, dt * 16);
                    proj.vy += (desiredVy - proj.vy) * Math.min(1, dt * 16);
                }

                proj.x += proj.vx * dt;
                proj.y += proj.vy * dt;
                proj.rotation += dt * 12;
                proj.life -= dt;

                let hit = false;
                for (let j = 0; j < kids.length; j++) {
                    const k = kids[j];
                    if (k.state !== 'waiting') continue;
                    if (Math.hypot(proj.x - k.x, proj.y - k.y) < proj.radius + k.radius + 16) {
                        feedKid(k);
                        hit = true;
                        break;
                    }
                }

                if (hit || proj.life <= 0 || proj.x < 0 || proj.x > WORLD_W || proj.y < 0 || proj.y > WORLD_H) {
                    projectiles.splice(i, 1);
                }
            }

            for (let i = 0; i < MAX_PARTICLES; i++) {
                const pt = particlePool[i];
                if (!pt.active) continue;
                pt.x += pt.vx * dt;
                pt.y += pt.vy * dt;
                pt.vy += 170 * dt;
                pt.life -= dt;
                if (pt.life <= 0) pt.active = false;
            }

            for (let i = 0; i < MAX_FLOATING_TEXTS; i++) {
                const ft = floatingTextPool[i];
                if (!ft.active) continue;
                ft.y -= 40 * dt;
                ft.life -= dt;
                if (ft.life <= 0) ft.active = false;
            }

            const sec = Math.ceil(gameState.timeLeft);
            if (sec !== lastDisplayedSec) {
                lastDisplayedSec = sec;
                const timerEl = document.getElementById('hud-timer');
                timerEl.textContent = `${sec}s`;
                timerEl.className = sec <= 10
                    ? 'font-display font-bold text-sm sm:text-base text-red-400 animate-pulse leading-tight'
                    : 'font-display font-bold text-sm sm:text-base text-emerald-300 leading-tight';
            }
        }

        /********************************************************************
         * 6. RENDERING PIPELINE (60 FPS Responsive Camera + 3D Ñaño Jorge)
         ********************************************************************/
        function draw() {
            ctx.save();
            ctx.translate(-camera.x, -camera.y);

            if (staticParkCanvas) {
                ctx.drawImage(staticParkCanvas, 0, 0);
            }

            ctx.fillStyle = 'rgba(255, 255, 255, 0.86)';
            for (let i = 0; i < clouds.length; i++) {
                const c = clouds[i];
                ctx.beginPath();
                ctx.arc(c.x, c.y, 17 * c.scale, 0, Math.PI * 2);
                ctx.arc(c.x + 15 * c.scale, c.y - 4 * c.scale, 21 * c.scale, 0, Math.PI * 2);
                ctx.arc(c.x + 32 * c.scale, c.y, 16 * c.scale, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.45)';
            ctx.lineWidth = 2;
            const ripple = (gameState.worldTime * 18) % 28;
            ctx.beginPath();
            ctx.ellipse(310, 433, 68 + ripple, 28 + ripple * 0.35, 0, 0, Math.PI * 2);
            ctx.stroke();

            drawNutriTruck(truckStation.x, truckStation.y);

            for (let i = 0; i < powerups.length; i++) {
                drawPowerup(powerups[i]);
            }

            if (gameState.status === 'playing' && player.lockedKid && (player.milk > 0 || player.multiMilkTimer > 0)) {
                drawAutoAimReticle(player.lockedKid);
            }

            for (let i = 0; i < kids.length; i++) {
                drawKid(kids[i]);
            }

            drawPlayer();

            for (let i = 0; i < projectiles.length; i++) {
                drawMilkCarton(projectiles[i]);
            }

            for (let i = 0; i < MAX_PARTICLES; i++) {
                const pt = particlePool[i];
                if (pt.active) drawParticle(pt);
            }

            for (let i = 0; i < MAX_FLOATING_TEXTS; i++) {
                const ft = floatingTextPool[i];
                if (!ft.active) continue;
                const alpha = Math.max(0, ft.life / ft.maxLife);
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.font = 'bold 16.5px "Fredoka", sans-serif';
                ctx.textAlign = 'center';
                ctx.lineWidth = 3.5;
                ctx.strokeStyle = '#ffffff';
                ctx.strokeText(ft.text, ft.x, ft.y);
                ctx.fillStyle = ft.color;
                ctx.fillText(ft.text, ft.x, ft.y);
                ctx.restore();
            }

            ctx.restore();

            // Off-screen indicators on mobile portrait so player always sees Truck & Kids
            if (camera.viewW < WORLD_W && gameState.status === 'playing') {
                drawOffscreenIndicators();
            }
        }

        function drawOffscreenIndicators() {
            const margin = 34;
            const leftEdge = camera.x + margin;
            const rightEdge = camera.x + camera.viewW - margin;

            // Truck indicator if outside camera view
            if (truckStation.x < camera.x + 20 || truckStation.x > camera.x + camera.viewW - 20) {
                const isLeft = truckStation.x < camera.x + 20;
                const ix = isLeft ? margin : camera.viewW - margin;
                const iy = Math.max(85, Math.min(camera.viewH - 140, truckStation.y));

                ctx.save();
                ctx.fillStyle = '#0284c7';
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 2.5;
                ctx.beginPath();
                ctx.arc(ix, iy, 22, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 11px "Fredoka", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(isLeft ? '◀ 🚚' : '🚚 ▶', ix, iy + 4);
                ctx.restore();
            }

            // Waiting kids indicators
            for (let i = 0; i < kids.length; i++) {
                const k = kids[i];
                if (k.state !== 'waiting') continue;
                if (k.x < leftEdge || k.x > rightEdge) {
                    const isLeft = k.x < leftEdge;
                    const ix = isLeft ? 24 : camera.viewW - 24;
                    const iy = Math.max(85, Math.min(camera.viewH - 140, k.y));

                    ctx.save();
                    ctx.fillStyle = k.patience < k.maxPatience * 0.35 ? '#ef4444' : '#16a34a';
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 2;
                    ctx.beginPath();
                    ctx.arc(ix, iy, 15, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = '#ffffff';
                    ctx.font = 'bold 9.5px "Fredoka", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(isLeft ? '◀🥛' : '🥛▶', ix, iy + 3.5);
                    ctx.restore();
                }
            }
        }

