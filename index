        // Input State
        const keys = {
            up: false,
            down: false,
            left: false,
            right: false
        };

        // Responsive Camera System (prevents stretching on mobile portrait while keeping 60 FPS)
        const camera = {
            x: 0,
            y: 0,
            viewW: WORLD_W,
            viewH: WORLD_H
        };

        function screenToWorld(clientX, clientY) {
            const rect = canvas.getBoundingClientRect();
            const normX = (clientX - rect.left) / Math.max(1, rect.width);
            const normY = (clientY - rect.top) / Math.max(1, rect.height);
            return {
                x: camera.x + normX * camera.viewW,
                y: camera.y + normY * camera.viewH
            };
        }

        /********************************************************************
         * 3. INPUT CONTROLLERS (Keyboard, Mouse, Touch & Continuous Drag Pad)
         ********************************************************************/
        window.addEventListener('keydown', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w' || e.key === 'ArrowUp') keys.up = true;
            if (k === 's' || e.key === 'ArrowDown') keys.down = true;
            if (k === 'a' || e.key === 'ArrowLeft') keys.left = true;
            if (k === 'd' || e.key === 'ArrowRight') keys.right = true;

            if (e.code === 'Space') {
                e.preventDefault();
                if (gameState.status === 'playing') throwMilk();
            }
            if (e.key === 'Shift') {
                e.preventDefault();
                if (gameState.status === 'playing') triggerDash();
            }
            if (k === 'p' || e.key === 'Escape') {
                if (gameState.status === 'playing' || gameState.status === 'paused') {
                    togglePause();
                }
            }
        });

        window.addEventListener('keyup', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w' || e.key === 'ArrowUp') keys.up = false;
            if (k === 's' || e.key === 'ArrowDown') keys.down = false;
            if (k === 'a' || e.key === 'ArrowLeft') keys.left = false;
            if (k === 'd' || e.key === 'ArrowRight') keys.right = false;
        });

        canvas.addEventListener('pointerdown', (e) => {
            if (gameState.status !== 'playing') return;
            const pt = screenToWorld(e.clientX, e.clientY);
            throwMilk(pt.x, pt.y);
        });

        // Responsive Touch Pad: supports both button taps AND smooth 360° finger sliding
        const touchPad = document.getElementById('touch-pad');
        let activeTouchId = null;

        function updateDirectionFromTouchPad(clientX, clientY) {
            const rect = touchPad.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = clientX - cx;
            const dy = clientY - cy;
            const deadZone = 10;

            keys.left = dx < -deadZone;
            keys.right = dx > deadZone;
            keys.up = dy < -deadZone;
            keys.down = dy > deadZone;
        }

        function resetTouchPadKeys() {
            keys.up = false;
            keys.down = false;
            keys.left = false;
            keys.right = false;
        }

        touchPad.addEventListener('touchstart', (e) => {
            e.preventDefault();
            const t = e.changedTouches[0];
            activeTouchId = t.identifier;
            updateDirectionFromTouchPad(t.clientX, t.clientY);
        }, { passive: false });

        touchPad.addEventListener('touchmove', (e) => {
            e.preventDefault();
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                if (t.identifier === activeTouchId) {
                    updateDirectionFromTouchPad(t.clientX, t.clientY);
                    break;
                }
            }
        }, { passive: false });

        touchPad.addEventListener('touchend', (e) => {
            e.preventDefault();
            for (let i = 0; i < e.changedTouches.length; i++) {
                if (e.changedTouches[i].identifier === activeTouchId) {
                    activeTouchId = null;
                    resetTouchPadKeys();
                    break;
                }
            }
        }, { passive: false });

        touchPad.addEventListener('touchcancel', () => {
            activeTouchId = null;
            resetTouchPadKeys();
        });

        document.querySelectorAll('.dpad-btn').forEach((btn) => {
            const dir = btn.dataset.dir;
            const start = (ev) => { ev.preventDefault(); keys[dir] = true; };
            const end = (ev) => { ev.preventDefault(); keys[dir] = false; };
            btn.addEventListener('mousedown', start);
            btn.addEventListener('mouseup', end);
            btn.addEventListener('mouseleave', end);
        });

        document.getElementById('btn-touch-throw').addEventListener('pointerdown', (e) => {
            e.preventDefault();
            if (gameState.status === 'playing') throwMilk();
        });

        document.getElementById('btn-touch-dash').addEventListener('pointerdown', (e) => {
            e.preventDefault();
            if (gameState.status === 'playing') triggerDash();
        });

